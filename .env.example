# ============================================================================
# DataVoice Agent - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values
# ============================================================================

# ----------------------------------------------------------------------------
# Required: API Keys
# ----------------------------------------------------------------------------
# Gemini API Key - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ----------------------------------------------------------------------------
# Optional: Business Customization
# ----------------------------------------------------------------------------
# Your business/organization name (used in AI prompts)
BUSINESS_NAME="Your Business Name"

# Industry type: retail, ecommerce, saas, healthcare, finance, manufacturing, other
INDUSTRY_TYPE="retail"

# Primary database type: mysql, postgres
DATABASE_TYPE="mysql"

# Default chart type for visualizations: bar, line, pie, table
DEFAULT_CHART_TYPE="bar"

# Allow destructive queries (DELETE, DROP, TRUNCATE): true, false
ENABLE_DESTRUCTIVE_QUERIES="false"

# Custom instructions for the AI assistant
# Example: "Focus on sales metrics and customer analytics. Always show currency in USD."
CUSTOM_INSTRUCTIONS=""

# ----------------------------------------------------------------------------
# Optional: Database Defaults (for demo/testing)
# ----------------------------------------------------------------------------
# These can be used as default values in the connection form
DEFAULT_DB_HOST="localhost"
DEFAULT_DB_PORT="3306"
DEFAULT_DB_NAME="your_database"

# ----------------------------------------------------------------------------
# Optional: Application Settings
# ----------------------------------------------------------------------------
# The URL where this app is hosted (for production deployments)
APP_URL="http://localhost:3000"

# Enable debug mode for verbose logging: true, false
DEBUG_MODE="false"

# ----------------------------------------------------------------------------
# Notes:
# - Never commit .env.local to version control
# - Only .env.example should be committed
# - Restart the dev server after changing environment variables
# ----------------------------------------------------------------------------
