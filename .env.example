# ============================================================================
# University Voice Portal - Environment Configuration Template
# ============================================================================
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Required: API Keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key_here"

# ----------------------------------------------------------------------------
# Required: Supabase PostgreSQL Connection
# ----------------------------------------------------------------------------
# DATABASE_URL format: postgresql://user:password@host:port/database
# Get the connection string from your Supabase dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > Database > Connection string
# 4. Use the "Pool Query" format for production or "Direct Connection" for development
# ----------------------------------------------------------------------------

# Supabase connection string (use Pool Query for production)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Enable SSL for production (true/false)
SSL_ENABLED="true"

# ----------------------------------------------------------------------------
# University Configuration
# ----------------------------------------------------------------------------
UNIVERSITY_NAME="Your University Name"
INDUSTRY_TYPE="education"
DEFAULT_CHART_TYPE="bar"
DEBUG_MODE="false"

# ----------------------------------------------------------------------------
# Notes:
# - Replace all placeholder values with your actual credentials
# - Keep this file secure
# - Restart the server after changing values
# ----------------------------------------------------------------------------
