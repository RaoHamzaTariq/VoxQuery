# ============================================================================
# University Voice Portal - Environment Configuration Template
# ============================================================================
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Required: API Keys
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key_here"

# ----------------------------------------------------------------------------
# Required: Supabase PostgreSQL Connection
# ----------------------------------------------------------------------------
# Get these values from your Supabase project dashboard:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Settings > Database
# ----------------------------------------------------------------------------

# Supabase Host (e.g., abcdefghijklmnop.supabase.co)
DB_HOST="your-project-ref.supabase.co"

# Database Port (default: 5432)
DB_PORT="5432"

# Database Name (default: postgres)
DB_NAME="postgres"

# Database User (default: postgres)
DB_USER="postgres"

# Database Password (from Supabase Settings)
DB_PASSWORD="your-database-password-here"

# Enable SSL for production (true/false)
SSL_ENABLED="true"

# ----------------------------------------------------------------------------
# University Configuration
# ----------------------------------------------------------------------------
UNIVERSITY_NAME="Your University Name"
INDUSTRY_TYPE="education"
DEFAULT_CHART_TYPE="bar"
DEBUG_MODE="false"

# ----------------------------------------------------------------------------
# Notes:
# - Replace all placeholder values with your actual credentials
# - Keep this file secure
# - Restart the server after changing values
# ----------------------------------------------------------------------------
